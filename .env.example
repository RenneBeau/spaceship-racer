# Optional environment variables. The app reads process.env; export these
# in your shell or use Node's --env-file option. Never add real wallet secrets.
RACER_HOST=127.0.0.1
RACER_PORT=8787
# Generated by local:smoke; alpha uses contracts/local/alpha-deployment.json.
RACER_MANIFEST=contracts/local/deployment.json
# Standalone alpha origin (match the address opened by your browser).
RACER_PUBLIC_ORIGIN=http://127.0.0.1:5110
# Leave disabled for standalone use. Requires a separate signed-login portal.
RACER_PORTAL_WALLET_ACCESS=false
